# Copy this file to `.env` and fill in real values.
# `.env` is gitignored; NEVER commit real values. Perms should be 0600.
#
# Nothing here has a default that reaches the network: every value below is
# either required or falls back to something inert. A missing required variable
# makes the bridge refuse to start rather than start wrong.

# ---------------------------------------------------------------------------
# smart-me API credentials
# ---------------------------------------------------------------------------
# PRIMARY — OAuth2 Client Credentials grant ("Device" app type; smart-me's recommended
# replacement for Basic auth on embedded devices). The bridge exchanges these for a
# bearer token, then calls the API with `Authorization: Bearer <token>`.
SMARTME_CLIENT_ID=
SMARTME_CLIENT_SECRET=
#
# FALLBACK — HTTP Basic auth (smart-me account user/password). RESERVED, and NOT
# read by the bridge today: `smart-me-client` implements Basic (ADR 0009) but the
# binary builds client-credentials unconditionally and never constructs it, so
# these two have no effect. And the pair above is REQUIRED, so setting these
# *instead* of it makes the bridge refuse to start. Same discipline as the broker
# credentials below: the names are fixed now so that wiring it up later is a
# configuration change rather than a migration.
# SMARTME_BASIC_USER=
# SMARTME_BASIC_PASSWORD=
#
# API base. Leave unset for the default (https://api.smart-me.com). Must be https:
# a plaintext base makes the client refuse to start.
# SMARTME_API_BASE=

# ---------------------------------------------------------------------------
# The meter (walking skeleton: exactly one)
# ---------------------------------------------------------------------------
# Logical name used internally and in logs.
SMARTME_METER_ID=
# The smart-me device UUID backing that meter.
SMARTME_DEVICE_ID=
# The meter's serial number. It becomes the Sparkplug device topic level, so a
# value that cannot be a topic level makes the bridge refuse to start.
SMARTME_SERIAL=

# ---------------------------------------------------------------------------
# MQTT broker
# ---------------------------------------------------------------------------
# Host or IP of the broker. This is deployment-specific — keep it here, not in
# any committed file.
SMARTME_BROKER_HOST=
# Port. Defaults to 1883 if unset. A value that is not a port number makes the
# bridge refuse to start rather than silently fall back.
# SMARTME_BROKER_PORT=1883
#
#
# Broker authentication — RESERVED. Planned and optional (FR43, NFR16); not yet
# honoured by the bridge. The names are fixed now so that turning authentication
# on later is a configuration change, not a migration. Same discipline as the
# smart-me credentials: .env only, never logged, never committed.
# SMARTME_BROKER_USER=
# SMARTME_BROKER_PASSWORD=
#
# NOTE: until both land, the broker connection is plain and unauthenticated, so
# the broker is expected to sit on a trusted internal network. Broker TLS is
# blocked upstream; when it lands, enable it together with authentication —
# MQTT sends credentials in the clear inside the CONNECT packet.

# ---------------------------------------------------------------------------
# Sparkplug identity
# ---------------------------------------------------------------------------
# Group and edge-node identifiers. BOTH ARE REQUIRED — there is no default, and
# the bridge refuses to start without them.
#
# They form the topic grammar, which is a versioned contract: changing them after
# a SCADA has started historising breaks its curves. And a Sparkplug host
# PERSISTS what it discovers — the group becomes a folder in its tag tree that
# outlives the process and has to be deleted by hand, which also discards the
# alarm and history configuration of everything under it. Publishing into the
# wrong namespace is not undone by restarting with better settings.
#
# They defaulted to `Site` / `Bridge` until 2026-07-31. The Tier-3 contract test
# has always REFUSED to publish into a group called `Site` for exactly the reason
# above; the product defaulted to it. The guard was on the disposable artifact
# and missing from the real one.
SMARTME_GROUP_ID=
SMARTME_NODE_ID=

# ---------------------------------------------------------------------------
# State
# ---------------------------------------------------------------------------
# Directory holding the persisted session number (bdSeq). Defaults to /data,
# which is the container mount point.
# SMARTME_STATE_DIR=/data

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# The console always gets everything. The settings below add a FILE alongside it
# and are opt-in: with SMARTME_LOG_DIR unset there is no log file at all, and the
# binary behaves exactly as it did before file logging existed.
#
# Directory for the log file. Setting it turns file logging ON. The file is
# `smartme_mqtt.<YYYY-MM-DD>.log`, rotated DAILY.
# SMARTME_LOG_DIR=/data/logs
#
# How many rotated files to keep. Defaults to 7 (one week). A value that is not a
# positive number is REFUSED, not guessed at: the bridge says so on stderr and
# keeps 7.
# SMARTME_LOG_KEEP=7
#
# NOTE: file logging never stops the bridge. If the directory cannot be created
# or the file cannot be opened, logging degrades to console-only and says why on
# stderr. On a container deployment the usual cause is the bind-mount's
# ownership — the directory must belong to the uid the container runs as (10002).
#
# NOTE: the FILE is lossy under pressure and the console is not. A saturated
# write buffer drops lines rather than blocking the bridge, so `docker compose
# logs` stays complete even when the file does not. The number of lost lines is
# reported at shutdown, so the loss is never silent.

# ---------------------------------------------------------------------------
# Log level
# ---------------------------------------------------------------------------
# Standard `tracing` filter, applied to the console and the file alike. Defaults
# to INFO — deliberately, and NOT to the ERROR that the library's own default
# would give, which would hide the ignored-NCMD traces, the QoS-downgrade warning
# and every traced drop. Raise it to debug one subsystem without drowning:
# RUST_LOG=info,smartme_bridge::adapters::mqtt_driver=debug
# RUST_LOG=info
